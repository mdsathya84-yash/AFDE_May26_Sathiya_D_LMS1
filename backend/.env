# ── Phase 1 ──────────────────────────────
DATABASE_URL=sqlite:///./library.db
CORS_ORIGINS=http://localhost:5173
APP_ENV=development

# ── Phase 2 (RAG) — fill in to enable ────
VECTOR_STORE_URL=          # ChromaDB URL or Pinecone API endpoint
EMBEDDING_MODEL=           # e.g. text-embedding-3-small (OpenAI)
                           #      or textembedding-gecko (Vertex AI)
OPENAI_API_KEY=            # Required if using OpenAI embeddings
VERTEX_AI_PROJECT=         # Required if using Vertex AI Vector Search
VERTEX_AI_LOCATION=        # e.g. us-central1
